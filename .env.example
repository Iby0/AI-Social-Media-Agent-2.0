# AI Social Media Agent & Autonomous Scheduler
# Environment Configuration Template

# Gemini API Key (Optional)
# Used for real-time generative post creation, smart visual prompts, and automated sentiment analysis.
# If omitted, the application seamlessly uses local intelligent heuristic AI fallback engines.
VITE_GEMINI_API_KEY=

# Production Environment Flag (Optional)
# Controls logger severity and service worker caching behavior.
NODE_ENV=production
