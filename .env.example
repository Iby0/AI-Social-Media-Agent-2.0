# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Meta Graph API Credentials (Facebook Page & Instagram Business Integration)
# META_APP_ID: The App ID from your Meta for Developers app dashboard.
META_APP_ID="YOUR_META_APP_ID"

# META_APP_SECRET: The App Secret from your Meta for Developers app dashboard (keep secret, server-side only).
META_APP_SECRET="YOUR_META_APP_SECRET"

# META_REDIRECT_URL: Authorized OAuth redirect URI configured in Meta App Settings.
META_REDIRECT_URL="https://your-domain.com/oauth/callback/meta"

# LinkedIn OAuth 2.0 Credentials
# LINKEDIN_CLIENT_ID: The Client ID generated in LinkedIn Developer Portal under your LinkedIn App settings.
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_CLIENT_ID"

# LINKEDIN_CLIENT_SECRET: The Client Secret associated with your LinkedIn App (keep secret, server-side only).
LINKEDIN_CLIENT_SECRET="YOUR_LINKEDIN_CLIENT_SECRET"

# LINKEDIN_REDIRECT_URL: Authorized OAuth 2.0 Redirect URI configured in your LinkedIn App settings.
LINKEDIN_REDIRECT_URL="https://your-domain.com/oauth/callback/linkedin"

# GitHub OAuth Web Application Credentials
# GITHUB_CLIENT_ID: The Client ID created in GitHub Settings > Developer Settings > OAuth Apps.
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"

# GITHUB_CLIENT_SECRET: The Client Secret created for your GitHub OAuth App (keep secret, server-side only).
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# GITHUB_REDIRECT_URL: Authorized OAuth Callback URL registered with your GitHub OAuth Application.
GITHUB_REDIRECT_URL="https://your-domain.com/oauth/callback/github"

# AI Content Generation Engine Configuration
GEMINI_MODEL="gemini-3.6-flash"
AI_TIMEOUT="15000"
AI_MAX_RETRIES="3"

# Module 19: Official Social Media Publishing Engine Credentials
FACEBOOK_APP_ID="YOUR_FACEBOOK_APP_ID"
FACEBOOK_APP_SECRET="YOUR_FACEBOOK_APP_SECRET"
INSTAGRAM_APP_ID="YOUR_INSTAGRAM_APP_ID"
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_CLIENT_ID"
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
APP_BASE_URL="https://your-domain.com"

